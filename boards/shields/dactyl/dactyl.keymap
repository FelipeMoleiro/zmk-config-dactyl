#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &out OUT_USB      &kp Q    &kp W  &kp E    &kp R    &kp T        &kp Y    &kp U    &kp K  &kp Q    &kp Q    &kp K
                &studio_unlock    &kp A    &kp S  &kp D    &kp F    &kp G        &kp Q    &kp J    &kp K  &kp Q    &kp Q    &kp K
                &bt BT_CLR_ALL    &kp Z    &kp X  &kp C    &kp V    &kp B        &kp Q    &kp M    &kp K  &kp Q    &kp Q    &kp K
                                  &kp K  &kp Q    &kp Q    &kp K        &kp Q    &kp Q    &kp K  &kp Q
                                 &out OUT_BLE &kp Q    &kp Q    &kp K        &kp Q    &kp Q    &kp K  &kp Q
            >;
        };
    };
 };
